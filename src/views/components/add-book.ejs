<div id="add-book-overlay">
  <div id="add-book">
    <div class="ab-header">
      <h2>Add Book</h2>
      <span class="ab-close" id="closeAddBookBtn">&times;</span>
    </div>
    <form
      id="abForm"
      onsubmit="return validateBook();"
      enctype="multipart/form-data"
      action="/admin/book/add"
      method="POST"
    >
      <div class="ab-body">
        <div class="ab-row-2">
          <div class="ab-field">
            <label for="title">Book name</label>
            <input
              type="text"
              id="title"
              name="title"
              placeholder="Atomic Habits"
            />
          </div>
          <div class="ab-field">
            <label for="author">Author</label>
            <input
              type="text"
              id="author"
              name="author"
              placeholder="James Clear"
            />
          </div>
        </div>

        <div class="ab-row-2">
          <div class="ab-field">
            <label for="pages">Pages</label>
            <input type="number" id="pages" name="pages" placeholder="120" />
          </div>
          <div class="ab-field">
            <label for="stock">Stock</label>
            <input type="number" id="stock" name="stock" placeholder="78" />
          </div>
        </div>

        <div class="ab-row-2">
          <div class="ab-field">
            <label for="category">Category</label>
            <select id="category" name="category">
              <option value="TECHNOLOGY">Technology</option>
              <option value="ROMANCE">Romance</option>
              <option value="BUSINESS">Business</option>
              <option value="SCIENCE">Science</option>
              <option value="HISTORY">History</option>
              <option value="CHILDREN">Children</option>
              <option value="FICTION">Fiction</option>
              <option value="OTHER">Other</option>
            </select>
          </div>
          <div class="ab-field">
            <label for="language">Language</label>
            <select id="language" name="language">
              <option value="UZBEK">Uzbek</option>
              <option value="ENGLISH">English</option>
              <option value="KOREAN">Korean</option>
              <option value="RUSSIAN">Russian</option>
              <option value="OTHER">Other</option>
            </select>
          </div>
        </div>

        <div class="ab-row-2">
          <div class="ab-field">
            <label for="price">Price ($)</label>
            <input
              type="number"
              id="price"
              name="price"
              placeholder="54"
              min="0"
              step="0.01"
            />
          </div>
          <div class="ab-field">
            <label for="publishedYear">Publishid year</label>
            <input
              type="number"
              id="publishedYear"
              name="publishedYear"
              placeholder="78"
              min="0"
            />
          </div>
        </div>
        <div class="ab-field">
          <label for="publishedYear">ISBN</label>
          <input
            type="text"
            id="isbn"
            name="isbn"
            placeholder="978-3-16-148410-0"
          />
        </div>

        <div class="ab-field">
          <label for="description">Description</label>
          <textarea
            id="description"
            name="description"
            placeholder="Write a short description about the book..."
          ></textarea>
        </div>

        <div class="ab-field">
          <label>Product Images</label>
          <label class="ab-upload-box">
            <span class="ab-upload-icon">&#128247;</span>
            <span class="ab-upload-text"
              >Click to upload images (max 5 allowed)</span
            >
            <input
              type="file"
              id="images"
              name="images"
              accept="image/*"
              multiple
            />
          </label>
          <div class="ab-preview-grid" id="abPreviewGrid"></div>
        </div>
      </div>

      <div class="ab-footer">
        <button type="button" class="ab-btn ab-btn-cancel">Cancel</button>
        <button type="submit" class="ab-btn ab-btn-save">Save Book</button>
      </div>
    </form>
  </div>
</div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/js/add-book.js"></script>
