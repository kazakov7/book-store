<%- include("components/header") %>
<body>
  <div class="container">
    <%- include("components/sidebar") %>
    <div class="main">
      <div class="top-bar">
        <h1>Dashboard</h1>
        <div class="topbar-avatar">
          <img
            src="/<%=user.memberImage%>"
            alt=""
            style="width: 40px; height: 40px; border-radius: 50%"
          />
          <strong><%=user.memberNick%></strong>
        </div>
      </div>
      <div class="content_frame">
        <div class="welcome">
          <div class="welcome_text">
            <strong>Good morning, <%=user.memberNick%></strong>
            <span>Here's what's happening in your bookstore today.</span>
          </div>
          <div class="welcome_icon">
            <img src="/images/icons/dashboard-book.svg" alt="" />
          </div>
        </div>
        <div class="statistics">
          <div class="statistics_card">
            <div class="card_top">
              <span>Total Books</span>
              <img src="/images/icons/Icon Wrap (3).svg" alt="" />
            </div>
            <div class="card_bott">
              <strong><%=books.length%></strong>
            </div>
          </div>
          <div class="statistics_card">
            <div class="card_top">
              <span>Total Users</span>
              <img src="/images/icons/Icon Wrap (1).svg" alt="" />
            </div>
            <div class="card_bott">
              <strong><%=users.length%></strong>
            </div>
          </div>
          <div class="statistics_card">
            <div class="card_top">
              <span>Total orders</span>
              <img src="/images/icons/Icon Wrap (1).svg" alt="" />
            </div>
            <div class="card_bott">
              <strong><%=orders.length%></strong>
            </div>
          </div>
          <div class="statistics_card">
            <div class="card_top">
              <span>Low stock</span>
              <img src="/images/icons/Icon Wrap (2).svg" alt="" />
            </div>
            <div class="card_bott">
              <strong>21</strong>
            </div>
          </div>
        </div>
        <div class="bottom-row">
          <section class="insights-card" id="insightsCard">
            <div class="insights-header">
              <h3>Library Insights</h3>
              <span class="insights-badge"
                ><span class="dot-pulse"></span>Live</span
              >
            </div>

            <div class="insights-stage" id="insightsStage">
              <div class="stage-inner" id="stageInner">
                <!-- ambient background -->
                <div class="blur-circle blur-1"></div>
                <div class="blur-circle blur-2"></div>
                <div class="blur-circle blur-3"></div>

                <svg
                  class="bg-pattern"
                  viewBox="0 0 800 320"
                  preserveAspectRatio="xMidYMid slice"
                >
                  <g fill="#3d5fea">
                    <!-- sparse dot grid, decorative only -->
                  </g>
                </svg>

                <div class="particles" id="particles"></div>

                <!-- connector lines between icon nodes, with traveling dots -->
                <svg
                  class="connector-svg"
                  viewBox="0 0 800 320"
                  preserveAspectRatio="none"
                >
                  <path
                    class="connector-path"
                    d="M 96 58 C 220 100, 300 130, 400 160"
                  />
                  <path
                    class="connector-path"
                    d="M 704 64 C 580 100, 500 130, 400 160"
                  />
                  <path
                    class="connector-path"
                    d="M 112 262 C 230 220, 310 190, 400 160"
                  />
                  <path
                    class="connector-path"
                    d="M 688 269 C 570 220, 490 190, 400 160"
                  />

                  <circle class="travel-dot" r="3">
                    <animateMotion
                      dur="4.5s"
                      repeatCount="indefinite"
                      path="M 96 58 C 220 100, 300 130, 400 160"
                    />
                  </circle>
                  <circle class="travel-dot" r="3">
                    <animateMotion
                      dur="5.2s"
                      repeatCount="indefinite"
                      path="M 704 64 C 580 100, 500 130, 400 160"
                    />
                  </circle>
                  <circle class="travel-dot" r="3">
                    <animateMotion
                      dur="4.8s"
                      repeatCount="indefinite"
                      path="M 112 262 C 230 220, 310 190, 400 160"
                    />
                  </circle>
                  <circle class="travel-dot" r="3">
                    <animateMotion
                      dur="5.6s"
                      repeatCount="indefinite"
                      path="M 688 269 C 570 220, 490 190, 400 160"
                    />
                  </circle>
                </svg>

                <!-- floating icon nodes -->
                <div class="node node-home" title="Home">
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                    <path d="M3 11l9-8 9 8" />
                    <path d="M5 10v10h14V10" />
                  </svg>
                </div>
                <div class="node node-users" title="Users">
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                    <circle cx="9" cy="8" r="3" />
                    <path d="M2 20c0-3.5 3-6 7-6s7 2.5 7 6" />
                    <path d="M17 8a3 3 0 1 1 0 6" />
                  </svg>
                </div>
                <div class="node node-books" title="Books">
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                    <path d="M4 4h6a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H4z" />
                    <path d="M20 4h-6a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h7z" />
                  </svg>
                </div>
                <div class="node node-category" title="Categories">
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="3" width="7" height="7" rx="1.5" />
                    <rect x="3" y="14" width="7" height="7" rx="1.5" />
                    <rect x="14" y="14" width="7" height="7" rx="1.5" />
                  </svg>
                </div>

                <!-- center open book -->
                <div class="book-scene">
                  <div class="book-base">
                    <div class="leaf left"></div>
                    <div class="leaf right"></div>
                  </div>
                  <div class="book-spine"></div>
                  <div class="page p1"></div>
                  <div class="page p2"></div>
                  <div class="page p3"></div>
                </div>
              </div>
            </div>

            <!-- decorative bottom dashboard strip -->
            <div class="insights-footer">
              <div class="footer-block">
                <div class="footer-label">Weekly checkouts</div>
                <div class="mini-chart" id="miniChart"></div>
              </div>
              <div class="footer-block">
                <div class="footer-label">Catalog health</div>
                <div class="progress-track">
                  <div class="progress-fill" style="--target: 82%"></div>
                </div>
                <div class="progress-track">
                  <div class="progress-fill alt" style="--target: 64%"></div>
                </div>
              </div>
              <div class="footer-block">
                <div class="footer-label">Reading trend</div>
                <svg
                  class="trend-line"
                  viewBox="0 0 220 46"
                  preserveAspectRatio="none"
                >
                  <path
                    class="trend-path"
                    d="M2 34 L36 22 L70 30 L104 12 L138 20 L172 8 L218 16"
                  />
                </svg>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="/js/home.js"></script>
</body>
